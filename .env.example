# procure-flow environment example
#
# The application reads configuration directly from the process environment and
# does NOT load .env files automatically. Use this file as a reference, or load
# it explicitly in your shell:
#
#   set -a && . ./.env && set +a && make run
#
# Copy to .env for local use:
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | staging | production
APP_ENV=development

# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
# Listen address. Use ":8080" to bind all interfaces, or "127.0.0.1:8080" for
# local-only access.
HTTP_ADDR=:8080

# Maximum time to read request headers (slowloris protection).
HTTP_READ_HEADER_TIMEOUT=5s

# Maximum time to read the entire request, including the body.
HTTP_READ_TIMEOUT=15s

# Maximum time to write the response.
HTTP_WRITE_TIMEOUT=30s

# Keep-alive idle connection timeout.
HTTP_IDLE_TIMEOUT=60s

# Per-request context deadline. Must be <= HTTP_WRITE_TIMEOUT.
HTTP_REQUEST_TIMEOUT=20s

# Budget for draining in-flight requests during graceful shutdown.
HTTP_SHUTDOWN_TIMEOUT=15s

# Maximum size of request headers in bytes (1 MiB).
HTTP_MAX_HEADER_BYTES=1048576

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection URL. Leave empty to use the in-memory repository
# (development and tests only). Required when APP_ENV=production.
#
# Local Docker: make db-up
# DATABASE_URL=postgres://procure:procure@127.0.0.1:55432/procure?sslmode=disable
DATABASE_URL=
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=25
# DB_CONN_MAX_LIFETIME=30m
# DB_CONN_MAX_IDLE_TIME=5m
# DB_AUTO_MIGRATE=true

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of exact origins (scheme + host + optional port).
# Wildcards ("*") are rejected. Leave empty to disable CORS headers.
#
# CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Authentication and authorization
# ---------------------------------------------------------------------------
# Enabled by default in staging and production; disabled in development, where
# every request is treated as a local admin. Production refuses to start when
# this is false.
# AUTH_ENABLED=true

# Static API keys as JSON. Each token must be at least 16 characters. Roles are
# admin, approver, requester, and viewer. Approvers are scoped to a department.
# AUTH_API_KEYS=[{"token":"local-admin-token-0123456789","subject":"user_admin","name":"Local Admin","roles":["admin"]}]

# HS256 JWT verification. The secret must be at least 32 characters.
# AUTH_JWT_SECRET=
# AUTH_JWT_ISSUER=procure-flow
# AUTH_JWT_AUDIENCE=procure-flow-api
# AUTH_JWT_LEEWAY=30s

# ---------------------------------------------------------------------------
# Idempotency
# ---------------------------------------------------------------------------
# Replay protection for POST /api/v1/procurements. Clients send an
# Idempotency-Key header and the stored response is replayed for the TTL.
# IDEMPOTENCY_ENABLED=true
# IDEMPOTENCY_TTL=24h

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Per-caller token bucket, keyed by authenticated subject or remote IP.
# Enabled by default in staging and production, disabled in development.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_RPS=20
# RATE_LIMIT_BURST=40

# ---------------------------------------------------------------------------
# Metrics
# ---------------------------------------------------------------------------
# Prometheus text exposition at /metrics. The endpoint is public like the
# health probes; restrict it at the network edge in production.
# METRICS_ENABLED=true

# ---------------------------------------------------------------------------
# API documentation
# ---------------------------------------------------------------------------
# Serve the interactive Scalar API reference at /docs and the OpenAPI document
# at /openapi.yaml. Defaults to true outside production and false in production.
# DOCS_ENABLED=false
