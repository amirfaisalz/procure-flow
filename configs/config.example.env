# Copy to .env and adjust for local development.
# The application reads these variables from the process environment; it does
# not load .env files automatically. Use your shell, systemd, or your container
# runtime to inject them.

APP_ENV=development
LOG_LEVEL=info

HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=20s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_MAX_HEADER_BYTES=1048576

# PostgreSQL connection URL. Empty selects the in-memory repository
# (development/tests only). Required when APP_ENV=production.
# DATABASE_URL=postgres://procure:procure@127.0.0.1:55432/procure?sslmode=disable
DATABASE_URL=
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=25
# DB_CONN_MAX_LIFETIME=30m
# DB_CONN_MAX_IDLE_TIME=5m
# DB_AUTO_MIGRATE=true

# Comma-separated exact origins. Wildcards are rejected.
# CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000
CORS_ALLOWED_ORIGINS=

# Serve the interactive Scalar API reference at /docs and the OpenAPI document
# at /openapi.yaml. Defaults to true outside production, false in production.
# DOCS_ENABLED=false
