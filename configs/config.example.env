# Copy to .env and adjust for local development.
# The application reads these variables from the process environment; it does
# not load .env files automatically. Use your shell, systemd, or your container
# runtime to inject them.

APP_ENV=development
LOG_LEVEL=info

HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=20s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_MAX_HEADER_BYTES=1048576

# PostgreSQL connection URL. Empty selects the in-memory repository
# (development/tests only). Required when APP_ENV=production.
# DATABASE_URL=postgres://procure:procure@127.0.0.1:55432/procure?sslmode=disable
DATABASE_URL=
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=25
# DB_CONN_MAX_LIFETIME=30m
# DB_CONN_MAX_IDLE_TIME=5m
# DB_AUTO_MIGRATE=true

# Comma-separated exact origins. Wildcards are rejected.
# CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000
CORS_ALLOWED_ORIGINS=

# Authentication. Disabled by default in development (local admin actor).
# Production requires AUTH_ENABLED=true and at least one credential source.
# AUTH_ENABLED=true
# AUTH_API_KEYS=[{"token":"local-admin-token-0123456789","subject":"user_admin","name":"Local Admin","roles":["admin"]}]
# AUTH_JWT_SECRET=
# AUTH_JWT_ISSUER=procure-flow
# AUTH_JWT_AUDIENCE=procure-flow-api
# AUTH_JWT_LEEWAY=30s

# Replay protection for write endpoints (Idempotency-Key).
# IDEMPOTENCY_ENABLED=true
# IDEMPOTENCY_TTL=24h

# Per-caller token bucket. Enabled by default outside development.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_RPS=20
# RATE_LIMIT_BURST=40
# auto (Redis when REDIS_URL is set), memory, or redis.
# RATE_LIMIT_STORE=auto

# Optional Redis: shared rate limiting and read-through caching.
# REDIS_URL=redis://127.0.0.1:6379/0
# CACHE_ENABLED=true
# CACHE_TTL=30s
# REDIS_DIAL_TIMEOUT=2s
# REDIS_COMMAND_TIMEOUT=1s

# Optional RabbitMQ: enables the outbox relay and async worker events.
# RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
# RABBITMQ_EXCHANGE=procure.events

# Optional worker webhooks. Empty simulates delivery with a log line.
# NOTIFICATION_WEBHOOK_URL=
# ERP_WEBHOOK_URL=

# Prometheus metrics at /metrics (public; restrict at the network edge).
# METRICS_ENABLED=true

# Serve the interactive Scalar API reference at /docs and the OpenAPI document
# at /openapi.yaml. Defaults to true outside production, false in production.
# DOCS_ENABLED=false
